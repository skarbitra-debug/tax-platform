# ============================================================
# Env-контракт платформы. Владелец схемы — packages/config (Zod).
# Правило: новая переменная появляется СНАЧАЛА здесь и в Zod-схеме,
# потом в коде. Никакого прямого process.env в приложениях.
# ============================================================

# ===== M0 — обязательно с первого дня =====
NODE_ENV=development
APP_URL=http://localhost:3000
# прод-домен (использует Caddy для TLS)
DOMAIN=

# Postgres (compose использует эти же значения)
POSTGRES_USER=tax
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=tax
DATABASE_URL=postgresql://tax:change-me-strong@localhost:5432/tax
# в prod-compose хост = postgres: postgresql://tax:...@postgres:5432/tax

# Auth.js
AUTH_SECRET=                # openssl rand -base64 33
AUTH_TRUST_HOST=true        # за reverse-proxy

# Seed админа (Татьяна) — используется только сидом, пароль потом сменить в ЛК
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

# Закрытый пилот: noindex на всех страницах
PILOT_NOINDEX=1

# Telegram-бот (скелет /start уже в M0)
TELEGRAM_BOT_TOKEN=         # от @BotFather

# ===== Сгенерировать в M0, обязателен с M4 (хранилище ФНС) =====
# 32 байта base64; живёт ТОЛЬКО в env, вне БД.
# Копия — в оффлайн-хранилище: потеря ключа = потеря всех логинов ФНС.
FNS_ENCRYPTION_KEY=         # openssl rand -base64 32

# ===== M3 (передача заявок в noname-канал девочек, §4.5) =====
# Заявка уходит в канал из web через Bot API; без этих двух передача
# молча пропускается (заявка всё равно создаётся и видна в ЛК).
TELEGRAM_CHANNEL_ID=        # -100xxxxxxxxxx

# ===== M3 (голосовой ассистент смены статусов, §4.7) =====
ANTHROPIC_API_KEY=          # ключ разбора команд (sk-ant-...)
TELEGRAM_ADMIN_CHAT_ID=     # chat_id Татьяны: ТОЛЬКО он двигает статусы голосом
VOICE_LLM_MODEL=claude-haiku-4-5-20251001  # модель разбора (дёшево/быстро)
# STT-движок (речь→текст) — выбирается позже (Yandex SpeechKit / Whisper),
# пока голосовой ассистент отвечает «в настройке» (createStt() — заглушка)

# ===== dev-опции =====
# SEED_DEV=1 — добавить тестового риэлтора и сделки при seed
SEED_DEV=0
