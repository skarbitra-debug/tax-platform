{
  "name": "tax-platform",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tax/web --filter @tax/bot dev",
    "dev:web": "pnpm --filter @tax/web dev",
    "dev:bot": "pnpm --filter @tax/bot dev",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm db:generate && pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @tax/db generate",
    "db:migrate": "pnpm --filter @tax/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @tax/db exec prisma migrate deploy",
    "db:studio": "pnpm --filter @tax/db exec prisma studio",
    "db:seed": "pnpm --filter @tax/db seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
